# RANN Agent Configuration

# LLM Provider
# Supported: custom, anthropic, openai, ollama
# Note: LLM_API_BASE should be the base URL (code adds /v1/chat/completions)
# Example: https://api.openai.com (results in /v1/chat/completions)
# Example: https://api.example.com/v1 (results in /v1/chat/completions - no double /v1)

LLM_PROVIDER=custom
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# Optional provider credentials (for direct env var usage)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Web Interface
WEB_AUTH_TOKEN=
WORKSPACE=/workspace
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///~/.rann-agent/data/sessions.db

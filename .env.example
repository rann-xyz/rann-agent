# Database
DATABASE_PATH=./rann.db

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900000

# Email (for OAuth - optional)
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=your-api-key
# EMAIL_FROM=noreply@rann.xyz

# OAuth Providers (optional)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Production CORS (comma-separated list of allowed origins)
# Example for production:
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com
# If CORS_ORIGINS is set, CORS_ORIGIN is ignored

# Workspace
WORKSPACE_ROOT=./workspaces

# ============================================================================
# LLM Provider Configuration (for OpenRouter or other custom providers)
# ============================================================================

# OpenRouter API Configuration
# Get your free API key at: https://openrouter.ai/settings/keys
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-api-key

# Optional: Request timeout in seconds (default: 60)
# LLM_TIMEOUT=60

# Model selection (for OpenRouter)
# agent.llm.model: anthropic/claude-3.5-sonnet
# agent.llm.provider: custom
# Rann Agent Configuration

# === LLM Provider API Keys ===
# Anthropic (primary)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (fallback)
OPENAI_API_KEY=sk-xxxxx

# Ollama (local models, no key needed)
OLLAMA_HOST=http://localhost:11434

# === Database ===
DATABASE_URL=sqlite:///~/.rann-agent/data/sessions.db

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=~/.rann-agent/logs/agent.log

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-secret-key-in-production

# === Optional Integrations ===
# GitHub
GITHUB_TOKEN=ghp_xxxxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord Bot
DISCORD_BOT_TOKEN=

# === Advanced ===
# Vector DB (optional, for semantic memory)
VECTOR_DB_PATH=~/.rann-agent/data/vectors
ENABLE_VECTOR_SEARCH=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry error tracking (optional)
SENTRY_DSN=

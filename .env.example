# =============================================================================
# RANN Agent Configuration Template
# Copy to .env and fill in your values
# NEVER commit your actual API keys to version control
# =============================================================================

# === LLM Provider API Keys ===
# Get your keys from the respective provider dashboards

# Anthropic (Claude models) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT models) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Groq (free tier available) - https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# === Local Models ===
# Ollama (local models, no key needed) - https://ollama.com/
OLLAMA_HOST=http://localhost:11434

# === Database ===
DATABASE_URL=sqlite:///~/.rann-agent/rann.db

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=~/.rann-agent/logs/agent.log

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-secret-key-in-production

# === Optional Integrations ===

# GitHub - https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Telegram Bot - https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord Bot - https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# === Advanced ===

# Vector DB (optional, for semantic memory)
VECTOR_DB_PATH=~/.rann-agent/data/vectors
ENABLE_VECTOR_SEARCH=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry error tracking (optional) - https://sentry.io
SENTRY_DSN=

# === Cache (optional) ===
# Redis URL for distributed caching (leave empty for in-memory fallback)
REDIS_URL=
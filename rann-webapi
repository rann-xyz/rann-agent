#!/bin/bash
# RANN Web API Manager - Start/Stop/Status tanpa perlu terminal terbuka

APP_DIR="/home/userland/rann-agent"
PYTHON="/home/userland/rann-agent/venv/bin/python3"
API_SCRIPT="$APP_DIR/web_api.py"
PID_FILE="/tmp/rann_webapi.pid"
LOG_FILE="/tmp/rann_webapi.log"

case "$1" in
    start)
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "RANN Web API sudah jalan (PID: $(cat $PID_FILE))"
        else
            echo "Menjalankan RANN Web API..."
            nohup $PYTHON $API_SCRIPT > $LOG_FILE 2>&1 &
            echo $! > $PID_FILE
            sleep 2
            if kill -0 $(cat $PID_FILE) 2>/dev/null; then
                echo "Berhasil! PID: $(cat $PID_FILE)"
                echo "Log: $LOG_FILE"
            else
                echo "Gagal jalan. Cek log: $LOG_FILE"
            fi
        fi
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            PID=$(cat $PID_FILE)
            if kill -0 $PID 2>/dev/null; then
                kill $PID && rm -f $PID_FILE
                echo "Stopped (PID: $PID)"
            else
                rm -f $PID_FILE
                echo "Process sudah mati"
            fi
        else
            echo "PID file tidak ada"
        fi
        ;;
    status)
        if [ -f "$PID_FILE" ] && kill -0 $(cat $PID_FILE) 2>/dev/null; then
            echo "🟢 Berjalan (PID: $(cat $PID_FILE))"
            tail -5 $LOG_FILE 2>/dev/null
        else
            echo "🔴 Tidak berjalan"
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    log)
        tail -20 $LOG_FILE
        ;;
    *)
        echo "Usage: rann-webapi {start|stop|status|restart|log}"
        ;;
esac